# Yerelde bu dosyayı .env.yerel olarak kopyalamaya gerek yok: `npm run dev` hiçbir ayar olmadan çalışır.
# Aşağıdakiler Vercel > Settings > Environment Variables bölümüne girilir (bkz. docs/kurulum.md).

# Neon (PostgreSQL) bağlantı adresi. Vercel'de Neon eklenince otomatik tanımlanır.
DATABASE_URL=

# Oturum çerezini imzalar; en az 32 rastgele karakter. Üretmek için: openssl rand -hex 32
OTURUM_SIRRI=

# Uygulamanın tam adresi (e-postalardaki bağlantı için), ör. https://etkinlik.yasar.edu.tr
UYGULAMA_URL=

# /kurulum sayfasını koruyan anahtar (en az 16 karakter)
KURULUM_ANAHTARI=

# Gece görevi (Vercel Cron) için gizli anahtar; Vercel Cron bunu otomatik gönderir. Üretmek için: openssl rand -hex 32
CRON_SECRET=

# E-posta (Resend). Boşsa e-postalar gönderilmez, yalnızca günlüğe yazılır.
RESEND_API_KEY=
EPOSTA_GONDEREN=

# Yalnızca `npm run kurulum` için: ilk yönetici olacak e-posta
ILK_YONETICI_EPOSTA=
